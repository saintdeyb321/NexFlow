<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>
  <!-- Compile against the approved API publish, with no extra packages/assets.
       At runtime use that image's API deps/runtimeconfig and native library. -->
  <ItemGroup>
    <Reference Include="SkiaSharp">
      <HintPath>$(ApiPublishDir)/SkiaSharp.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>
  <Target Name="RequireApiPublish" BeforeTargets="ResolveReferences">
    <Error Condition="!Exists('$(ApiPublishDir)/SkiaSharp.dll')" Text="Set ApiPublishDir to the approved API publish containing SkiaSharp.dll." />
  </Target>
</Project>
