{
  "Firebase": {
    "ProjectId": "nexflow-staging-local"
  },
  "Evolution": {
    "TimeoutSeconds": 10,
    "AllowLegacyWebhookKey": false
  },
  "N8n": {
    "EventsWebhookId": "nexflow-events",
    "TimeoutSeconds": 30
  },
  "Cors": {
    "AllowedOrigins": [
      "http://localhost:5173"
    ]
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "NexFlow.API.Middleware.UserIdentityMiddleware": "Warning"
    }
  }
}
