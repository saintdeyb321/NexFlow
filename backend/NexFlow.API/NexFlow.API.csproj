    <PackageReference Include="Swashbuckle.AspNetCore" Version="10.2.3" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\NexFlow.Infrastructure\NexFlow.Infrastructure.csproj" />
