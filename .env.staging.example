# This file contains placeholders only. Start-LocalStaging.ps1 copies it to the
# ignored .env.staging file and generates the five local-only secrets below.
STAGING_POSTGRES_PASSWORD=CHANGE_ME
STAGING_EVOLUTION_POSTGRES_PASSWORD=CHANGE_ME
STAGING_EVOLUTION_API_KEY=CHANGE_ME
STAGING_EVOLUTION_WEBHOOK_KEY=CHANGE_ME
STAGING_N8N_WEBHOOK_SECRET=CHANGE_ME

# Public, disposable identifiers and loopback ports.
STAGING_FIREBASE_PROJECT_ID=nexflow-staging-local
STAGING_API_PORT=58081
STAGING_POSTGRES_PORT=55432
STAGING_REDIS_PORT=56379
STAGING_FIRESTORE_PORT=58080

# Optional real provider credentials. Keep blank until the operator provides
# credentials restricted to the staging budget/project. They are never copied
# into the image or committed to the repository.
STAGING_GEMINI_API_KEY=
STAGING_GEMINI_MODEL=gemini-3.5-flash
STAGING_GEMINI_FALLBACK_MODEL=gemini-3.1-flash-lite
STAGING_GROQ_API_KEY=
STAGING_GROQ_MODEL=openai/gpt-oss-20b

# Required only with Start-LocalStaging.ps1 -WithEvolution. These values must
# come from the pinned Evolution provider installation; NexFlow does not own
# that container contract.
STAGING_EVOLUTION_IMAGE=
STAGING_EVOLUTION_RUNTIME_ENV_FILE=./staging/evolution/.env
STAGING_EVOLUTION_DATA_PATH=
STAGING_EVOLUTION_PORT=58082
